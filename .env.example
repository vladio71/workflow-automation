DATABASE_URL="postgresql://app:app@localhost:5433/learning"
# https://aistudio.google.com/apikey  (без ключа апка працює, просто без AI-оцінки і mock-інтерв'ю)
GEMINI_API_KEY=""
# Назву моделі дивись в AI Studio; безкоштовні моделі Google періодично міняє.
# Можна кілька через кому: перша основна, решта запасні. На ліміт (429), перевантаження (503), обрив відповіді,
# зависання (нічого не приходить 30-45 с), 404 чи помилку запиту апка одразу йде до наступної.
# Тільки останню в списку на 503 чи обрив пробує ще раз. Перевірка: Sources → Gemini.
GEMINI_MODEL="gemini-3.8-flash"
# Скриня: шукати новини, статті, музику, аніме і фільм через Gemini з Google Search. За замовчуванням вимкнено:
# у безкоштовного ключа пошук має свій маленький ліміт. Без нього картки з Hacker News, xkcd і статичні.
LOOT_AI_SEARCH=""
# Тільки для приватних репо в /sources: fine-grained token з доступом Contents: read-only
GITHUB_TOKEN=""
# Рівні (/levels): шлях до локального клону live-code (vladio71/live-code). Усередині нього один раз npm install.
# Код, який вставляєш на сторінці рівня, запускається тестами на цьому комп'ютері, тому апка слухає тільки 127.0.0.1.
LEVELS_DIR=""
# Telegram-бот (npm run bot): токен дає @BotFather. Chat id бот скаже сам: запусти його без TELEGRAM_CHAT_ID і напиши /start.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# О котрій надсилати першу картку дня, за часом цього комп'ютера
TELEGRAM_SEND_AT="09:00"
# Часовий пояс, за яким апка рахує "сьогодні". Локально порожньо = час комп'ютера. На Vercel без нього береться Europe/Kyiv.
APP_TZ=""
