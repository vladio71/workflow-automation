generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Track {
  GRAPHQL
  SYSTEM_DESIGN
  NODE
  AI
  PYTHON
  OTHER
}

/// CONCEPT = question/answer (cards on the Cards page), TASK = hands-on task (Recall and plan)
enum CardKind {
  CONCEPT
  TASK
}

enum ActivityKind {
  STUDY
  DRILL
  RECALL
  QUESTIONS
  READING
  MOCK
  OTHER
  CARDS
}

/// Card grade. PRACTICE = viewed in free mode (All cards), schedule unchanged.
enum CardGrade {
  FORGOT
  HARD
  GOOD
  PRACTICE
}

enum Confidence {
  NOT_STARTED
  RED
  AMBER
  GREEN
}

enum CycleStatus {
  PLANNED
  ACTIVE
  DONE
}

enum MessageRole {
  USER
  MODEL
}

/// Topic = a row of the retrospective timetable. notes = the topic's knowledge base (markdown).
model Topic {
  id           Int         @id @default(autoincrement())
  name         String
  track        Track
  confidence   Confidence  @default(NOT_STARTED)
  lastRecallAt DateTime?
  /// current interval step in days (2 -> 7 -> 21 -> 42 -> 84)
  intervalDays Int         @default(0)
  nextReviewAt DateTime?
  drill        String      @default("")
  source       String      @default("")
  notes        String      @default("")
  cycleId      Int?
  cycle        Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  /// topic synced from a repo: learn/topic.md (sourcePath "") or learn/<sourcePath>/topic.md
  sourceId     Int?
  sourcePath   String      @default("")
  syncSource   Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  questions    Question[]
  recalls      RecallLog[]
  activities   ActivityLog[]
  /// topic as a card category: when it was last used (assigned to a card, its cards reviewed); the category picker sorts by it
  cardsUsedAt  DateTime?
  /// category deadline (e.g. an interview date): until it the cards repeat more often and go first in the queue, after it the category is ordinary; date only, deadline day inclusive
  deadline     DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([nextReviewAt])
  @@unique([sourceId, sourcePath])
}

/// Questions, not notes: own question + answer from memory + reference answer.
model Question {
  id        Int         @id @default(autoincrement())
  kind      CardKind    @default(CONCEPT)
  question  String
  myAnswer  String      @default("")
  reference String      @default("")
  /// TASK: reference file in the repo and the check command
  ref       String      @default("")
  check     String      @default("")
  /// card schedule (CONCEPT only): null = new, never seen
  cardDueAt      DateTime?
  cardInterval   Int         @default(0)
  cardLapses     Int         @default(0)
  cardReviewedAt DateTime?
  cardReviews    CardReview[]
  /// card deliveries via the Telegram bot, one per day
  telegramDeliveries TelegramDelivery[]
  /// repo cards: stable key so Sync updates instead of duplicating
  sourceKey String?     @unique
  sourceId  Int?
  syncSource Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// repo card edited in the app (All cards -> Edit): Sync no longer overwrites its text
  editedInApp Boolean   @default(false)
  topicId   Int?
  topic     Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  recalls   RecallLog[]
  createdAt DateTime    @default(now())
}

/// Repo card deleted in the app. Sync sees its key here and does not recreate the card.
model DeletedCard {
  id        Int      @id @default(autoincrement())
  sourceId  Int
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// the same key the card had in Question.sourceKey
  sourceKey String
  /// question text at deletion time, so the DB shows what was removed
  question  String
  createdAt DateTime @default(now())

  @@unique([sourceId, sourceKey])
}

/// One recall from memory: what was written, what the AI said, which colour was set.
model RecallLog {
  id              Int        @id @default(autoincrement())
  topicId         Int
  topic           Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionId      Int?
  question        Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answer          String
  feedback        String     @default("")
  confidenceAfter Confidence
  createdAt       DateTime   @default(now())
}

/// Cycle without fixed dates: order (number), status, goal, retro.
model Cycle {
  id        Int         @id @default(autoincrement())
  number    Int         @unique
  name      String
  goal      String      @default("")
  status    CycleStatus @default(PLANNED)
  retro     String      @default("")
  topics    Topic[]
  createdAt DateTime    @default(now())
}

/// Time log: minutes spent and on what; streak and analytics come from it. Recall and mock write here automatically, the rest is added by hand.
model ActivityLog {
  id        Int          @id @default(autoincrement())
  day       DateTime     @db.Date
  minutes   Int
  kind      ActivityKind
  track     Track?
  topicId   Int?
  topic     Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@index([day])
}

/// Daily checklist. One row per day.
model DailyLog {
  day        DateTime @id @db.Date
  cardsDone  Boolean  @default(false)
  recallDone Boolean  @default(false)
  outLoud    Boolean  @default(false)
  note       String   @default("")
}

/// Item of the daily list on Today. One list for all days, ticks are per day (DailyCheck).
model DailyItem {
  id        Int          @id @default(autoincrement())
  title     String
  position  Int
  /// '' = ordinary item. 'cardsDone' | 'recallDone' | 'outLoud' = the tick lives in DailyLog and sets itself
  auto      String       @default("")
  checks    DailyCheck[]
  createdAt DateTime     @default(now())

  @@index([position])
}

/// Tick of an ordinary Daily item for one day.
model DailyCheck {
  itemId Int
  item   DailyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  day    DateTime  @db.Date

  @@id([itemId, day])
  @@index([day])
}

model InboxItem {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
}

model MockSession {
  id        Int           @id @default(autoincrement())
  problem   String
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  messages  MockMessage[]
}

model MockMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
}

/// AI day plan. items = JSON array of PlanItem (src/lib/planner.ts).
model DailyPlan {
  day           DateTime  @id @db.Date
  items         Json
  /// short explanation of why this plan
  summary       String    @default("")
  /// evening review: what was done, what to carry over
  review        String    @default("")
  /// null = draft: items can be removed, added, reordered. After "Start the day" the plan becomes the map
  startedAt     DateTime?
  /// day focus (src/lib/day-focus.ts): '' none, 'levels' live-code levels, 'plan:<Source.id>' study plan
  focus         String    @default("")
  /// free-text wish for the day, goes into the prompt
  wish          String    @default("")
  /// minute budget the plan was built with
  budget        Int       @default(0)
  /// why Gemini failed to build the plan (chain of attempts per model); '' = built or no API key
  aiError       String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Backlog column: BACKLOG is not planned into the day until pulled into TODO
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
}

enum TaskRepeat {
  /// one-off: suggested for the plan until done
  ONCE
  DAILY
  /// Mon-Fri
  WEEKDAYS
}

/// Task outside of study (send out resumes, deploy the app). In the day plan it is a TASK item.
model Task {
  id        Int        @id @default(autoincrement())
  title     String
  minutes   Int        @default(30)
  repeat    TaskRepeat @default(ONCE)
  /// session task: how many times per day (send 10 resumes). 0 = ordinary task with a tick
  target    Int        @default(0)
  /// one-off task: when done. Repeating tasks are ticked only in the day plan
  doneAt    DateTime?
  /// last day the task is still planned (interview prep until 19.10). null = no end
  until     DateTime?  @db.Date
  /// Jira-style backlog: BACKLOG | TODO | IN_PROGRESS; done = doneAt
  status    TaskStatus @default(BACKLOG)
  /// 1 high … 4 low
  priority  Int        @default(3)
  notes     String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  ticks     TaskTick[]
}

/// Evening handoff: "tomorrow I start with ...". day = the day this first step belongs to (one row per day).
model Handoff {
  day       DateTime @id @db.Date
  firstStep String
  createdAt DateTime @default(now())
}

/// One step of a session task: sent a resume, messaged a recruiter. The day's tower grows from these.
model TaskTick {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// day as in DailyPlan: the tower restarts every day
  day       DateTime @db.Date
  /// company or link, optional
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([taskId, day])
}

/// Repo the app pulls cards from: learn/topic.md + learn/questions.md
model Source {
  id           Int        @id @default(autoincrement())
  /// owner/name
  repo         String     @unique
  branch       String     @default("main")
  lastSyncedAt DateTime?
  lastError    String     @default("")
  lastSummary  String     @default("")
  /// commit SHA of the last successful sync: if unchanged, files are not downloaded
  lastSha      String     @default("")
  /// learn/plan.md: plan name and how many minutes per day it takes (0 = no plan)
  planName         String     @default("")
  planDailyMinutes Int        @default(0)
  topics       Topic[]
  planSteps    PlanStep[]
  questions    Question[]
  deletedCards DeletedCard[]
  createdAt    DateTime   @default(now())
}

enum PlanStepKind {
  READ
  ATTEMPT
  REFERENCE
  SUMMARY
  DEPTH
  EXAM
}

/// Study plan step from learn/plan.md. Order and text come from the repo, progress (doneAt) lives here.
model PlanStep {
  id        Int          @id @default(autoincrement())
  sourceId  Int
  source    Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Id: from plan.md; Sync matches steps by it, so progress survives reordering
  key       String
  position  Int
  /// the "## ..." heading above the step, e.g. "Week 1"
  group     String       @default("")
  title     String
  minutes   Int
  kind      PlanStepKind @default(READ)
  /// URL or path in the repo
  link      String       @default("")
  /// topic folder under learn/: ATTEMPT = recall of this topic
  topicPath String       @default("")
  doneAt    DateTime?

  @@unique([sourceId, key])
  @@index([sourceId, position])
}

/// Every card review: for scheduling, the daily new-card limit and time in Stats.
model CardReview {
  id         Int       @id @default(autoincrement())
  questionId Int
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  grade      CardGrade
  /// the card was new (first showing in Review mode)
  wasNew     Boolean   @default(false)
  /// seconds spent on the card (capped at 3 min so a tea break does not count)
  seconds    Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

enum TelegramDeliveryStatus {
  SENT
  REVEALED
  GRADED
  /// the Telegram grade no longer counts: the card was reviewed in the app or the send failed
  STALE
}

/// Card sent by the Telegram bot. One per card per day (UNIQUE): the bot never sends it twice, even after a restart.
model TelegramDelivery {
  id         Int                    @id @default(autoincrement())
  questionId Int
  question   Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// calendar day of the send, as in DailyLog.day
  day        DateTime               @db.Date
  chatId     String
  /// null until Telegram confirms the send
  messageId  Int?
  status     TelegramDeliveryStatus @default(SENT)
  grade      CardGrade?
  sentAt     DateTime               @default(now())
  revealedAt DateTime?
  gradedAt   DateTime?

  @@unique([questionId, day])
  @@index([day])
}

/// Attempt at a level, i.e. a live-code exercise (LEVELS_DIR). Exercises live in the repo, only attempts are here; the repeat schedule and the frame are computed from these rows (src/lib/level-schedule.ts).
model LevelAttempt {
  id         Int      @id @default(autoincrement())
  /// exercise folder relative to exercises/, e.g. "04-async/07-dataloader"
  levelKey   String
  code       String
  /// tests are green
  passed     Boolean
  /// opened the reference before passing: the level does not count toward today's frame, repeat in 2 days
  gaveUp     Boolean  @default(false)
  /// vitest output (truncated)
  output     String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([levelKey, createdAt])
}

enum LootRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// Rest card in the pool: from Gemini (news, article, film, anime, music), xkcd or Hacker News. Static cards (water, stretch, game) live in src/lib/loot.config.ts and are not stored in the DB.
model RestCard {
  id        Int        @id @default(autoincrement())
  /// MEME | NEWS | ARTICLE | FILM | ANIME | MUSIC (a string so new kinds need no migration)
  kind      String
  rarity    LootRarity
  title     String
  body      String     @default("")
  url       String     @default("")
  imageUrl  String     @default("")
  minutes   Int
  /// gemini | xkcd | hn
  source    String
  /// keeps the same comic or article from entering the pool twice
  dedupeKey String     @unique
  /// long (film): drops only after the day's boss
  afterBoss Boolean    @default(false)
  expiresAt DateTime
  pulledAt  DateTime?
  pulls     RestPull[]
  createdAt DateTime   @default(now())

  @@index([rarity, pulledAt, expiresAt])
}

/// One pull from the chest. Card content is copied here because static cards are not in the DB and pool cards get deleted over time.
model RestPull {
  id         Int        @id @default(autoincrement())
  day        DateTime   @db.Date
  rarity     LootRarity
  kind       String
  title      String
  body       String     @default("")
  url        String     @default("")
  imageUrl   String     @default("")
  minutes    Int
  source     String
  /// why the rarity has a floor: "pity" (every 10th pull) or "boss"
  guarantee  String     @default("")
  restCardId Int?
  restCard   RestCard?  @relation(fields: [restCardId], references: [id], onDelete: SetNull)
  openedAt   DateTime   @default(now())
  /// pressed "Back to the map"
  finishedAt DateTime?

  @@index([day])
}

/// image for cards: stored in the database, shown in answers as ![alt](/api/images/<id>)
model CardImage {
  id        Int      @id @default(autoincrement())
  mime      String
  bytes     Bytes
  alt       String   @default("")
  createdAt DateTime @default(now())
}
