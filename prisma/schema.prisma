generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Track {
  GRAPHQL
  SYSTEM_DESIGN
  NODE
  AI
  PYTHON
  OTHER
}

/// CONCEPT = питання/відповідь (картки на сторінці Cards), TASK = задача руками (Recall і план)
enum CardKind {
  CONCEPT
  TASK
}

enum ActivityKind {
  STUDY
  DRILL
  RECALL
  QUESTIONS
  READING
  MOCK
  OTHER
  CARDS
}

/// Оцінка картки. PRACTICE = переглянув у вільному режимі (All cards), розклад не міняється.
enum CardGrade {
  FORGOT
  HARD
  GOOD
  PRACTICE
}

enum Confidence {
  NOT_STARTED
  RED
  AMBER
  GREEN
}

enum CycleStatus {
  PLANNED
  ACTIVE
  DONE
}

enum MessageRole {
  USER
  MODEL
}

/// Тема = рядок retrospective timetable. notes = база знань по темі (markdown).
model Topic {
  id           Int         @id @default(autoincrement())
  name         String
  track        Track
  confidence   Confidence  @default(NOT_STARTED)
  lastRecallAt DateTime?
  /// поточний крок інтервалу в днях (2 -> 7 -> 21 -> 42 -> 84)
  intervalDays Int         @default(0)
  nextReviewAt DateTime?
  drill        String      @default("")
  source       String      @default("")
  notes        String      @default("")
  cycleId      Int?
  cycle        Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  /// тема, яка синхронізується з репо: learn/topic.md (sourcePath "") або learn/<sourcePath>/topic.md
  sourceId     Int?
  sourcePath   String      @default("")
  syncSource   Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  questions    Question[]
  recalls      RecallLog[]
  activities   ActivityLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([nextReviewAt])
  @@unique([sourceId, sourcePath])
}

/// Питання, а не конспекти: своє питання + відповідь з пам'яті + еталон.
model Question {
  id        Int         @id @default(autoincrement())
  kind      CardKind    @default(CONCEPT)
  question  String
  myAnswer  String      @default("")
  reference String      @default("")
  /// TASK: файл-еталон у репо і команда перевірки
  ref       String      @default("")
  check     String      @default("")
  /// розклад картки (тільки CONCEPT): null = нова, ще не бачив
  cardDueAt      DateTime?
  cardInterval   Int         @default(0)
  cardLapses     Int         @default(0)
  cardReviewedAt DateTime?
  cardReviews    CardReview[]
  /// показ картки в Telegram-боті, один на день
  telegramDeliveries TelegramDelivery[]
  /// для карток з репо: стабільний ключ, щоб Sync оновлював, а не дублював
  sourceKey String?     @unique
  sourceId  Int?
  syncSource Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  topicId   Int?
  topic     Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  recalls   RecallLog[]
  createdAt DateTime    @default(now())
}

/// Одне відтворення з пам'яті: що написав, що сказав AI, який колір поставив.
model RecallLog {
  id              Int        @id @default(autoincrement())
  topicId         Int
  topic           Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionId      Int?
  question        Question?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answer          String
  feedback        String     @default("")
  confidenceAfter Confidence
  createdAt       DateTime   @default(now())
}

/// Цикл без жорстких дат: порядок (number), статус, ціль, ретро.
model Cycle {
  id        Int         @id @default(autoincrement())
  number    Int         @unique
  name      String
  goal      String      @default("")
  status    CycleStatus @default(PLANNED)
  retro     String      @default("")
  topics    Topic[]
  createdAt DateTime    @default(now())
}

/// Лог часу: скільки хвилин і на що. З нього рахуються стрік і аналітика.
/// Recall і mock пишуть сюди самі, решту додаєш руками.
model ActivityLog {
  id        Int          @id @default(autoincrement())
  day       DateTime     @db.Date
  minutes   Int
  kind      ActivityKind
  track     Track?
  topicId   Int?
  topic     Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@index([day])
}

/// Щоденний чекліст. Один рядок на день.
model DailyLog {
  day        DateTime @id @db.Date
  cardsDone  Boolean  @default(false)
  recallDone Boolean  @default(false)
  outLoud    Boolean  @default(false)
  note       String   @default("")
}

model InboxItem {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
}

model MockSession {
  id        Int           @id @default(autoincrement())
  problem   String
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  messages  MockMessage[]
}

model MockMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
}

/// План на день від AI. items = JSON масив PlanItem (src/lib/planner.ts).
model DailyPlan {
  day           DateTime  @id @db.Date
  items         Json
  /// коротке пояснення, чому саме такий план
  summary       String    @default("")
  /// вечірній огляд: що зроблено, що перенести
  review        String    @default("")
  /// null = чернетка: пункти можна прибирати, додавати, переставляти. Після "Start the day" лишаються тільки галочки
  startedAt     DateTime?
  /// навчальний план (Source.id), якому віддали більшу частину бюджету
  focusSourceId Int?
  /// побажання на день вільним текстом, іде в промпт
  wish          String    @default("")
  /// бюджет хвилин, з яким складали план
  budget        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum TaskRepeat {
  /// разова: пропонується в план, поки не зробиш
  ONCE
  DAILY
  /// пн-пт
  WEEKDAYS
}

/// Справа поза навчанням (розіслати резюме, задеплоїти апку). У плані дня це пункт TASK.
model Task {
  id        Int        @id @default(autoincrement())
  title     String
  minutes   Int        @default(30)
  repeat    TaskRepeat @default(ONCE)
  /// разова справа: коли зроблено. Повторювані відмічаються тільки в плані дня
  doneAt    DateTime?
  createdAt DateTime   @default(now())
}

/// Репо, з якого апка підтягує картки: learn/topic.md + learn/questions.md
model Source {
  id           Int        @id @default(autoincrement())
  /// owner/name
  repo         String     @unique
  branch       String     @default("main")
  lastSyncedAt DateTime?
  lastError    String     @default("")
  lastSummary  String     @default("")
  /// SHA коміту останнього успішного sync: не змінився, тоді файли не качаємо
  lastSha      String     @default("")
  /// learn/plan.md: назва плану і скільки хвилин на день він бере (0 = плану немає)
  planName         String     @default("")
  planDailyMinutes Int        @default(0)
  topics       Topic[]
  planSteps    PlanStep[]
  questions    Question[]
  createdAt    DateTime   @default(now())
}

enum PlanStepKind {
  READ
  ATTEMPT
  REFERENCE
  SUMMARY
  DEPTH
  EXAM
}

/// Крок навчального плану з learn/plan.md. Порядок і текст приходять з репо, прогрес (doneAt) живе тут.
model PlanStep {
  id        Int          @id @default(autoincrement())
  sourceId  Int
  source    Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Id: з plan.md; по ньому Sync знаходить крок, тож прогрес не губиться, коли кроки переставляють
  key       String
  position  Int
  /// заголовок "## ..." над кроком, наприклад "Тиждень 1"
  group     String       @default("")
  title     String
  minutes   Int
  kind      PlanStepKind @default(READ)
  /// URL або шлях у репо
  link      String       @default("")
  /// папка теми в learn/: ATTEMPT = recall цієї теми
  topicPath String       @default("")
  doneAt    DateTime?

  @@unique([sourceId, key])
  @@index([sourceId, position])
}

/// Кожен показ картки: для розкладу, ліміту нових на день і часу в Stats.
model CardReview {
  id         Int       @id @default(autoincrement())
  questionId Int
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  grade      CardGrade
  /// картка була нова (перший показ у режимі Review)
  wasNew     Boolean   @default(false)
  /// скільки секунд пішло на картку (обрізано до 3 хв, щоб перерва на чай не рахувалась)
  seconds    Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

enum TelegramDeliveryStatus {
  SENT
  REVEALED
  GRADED
  /// оцінка з Telegram уже не рахується: картку повторили в апці або відправка обірвалась
  STALE
}

/// Картка, надіслана Telegram-ботом. Одна на картку за день (UNIQUE): бот не шле її двічі навіть після рестарту.
model TelegramDelivery {
  id         Int                    @id @default(autoincrement())
  questionId Int
  question   Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// календарний день розсилки, як DailyLog.day
  day        DateTime               @db.Date
  chatId     String
  /// null, поки Telegram не підтвердив відправку
  messageId  Int?
  status     TelegramDeliveryStatus @default(SENT)
  grade      CardGrade?
  sentAt     DateTime               @default(now())
  revealedAt DateTime?
  gradedAt   DateTime?

  @@unique([questionId, day])
  @@index([day])
}

/// Спроба пройти рівень = вправу з live-code (LEVELS_DIR). Самі вправи живуть у репо, тут тільки спроби.
/// Розклад повторів і рамка рахуються з цих рядків (src/lib/level-schedule.ts).
model LevelAttempt {
  id         Int      @id @default(autoincrement())
  /// папка вправи відносно exercises/, наприклад "04-async/07-dataloader"
  levelKey   String
  code       String
  /// тести зелені
  passed     Boolean
  /// відкрив еталон до проходження: сьогодні рівень не рахується в рамку, повтор через 2 дні
  gaveUp     Boolean  @default(false)
  /// вивід vitest (обрізаний)
  output     String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([levelKey, createdAt])
}

enum LootRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// Картка відпочинку в пулі: з Gemini (новина, стаття, фільм, аніме, музика), xkcd або Hacker News.
/// Статичні картки (вода, розминка, гра) живуть у src/lib/loot.config.ts і в БД не пишуться.
model RestCard {
  id        Int        @id @default(autoincrement())
  /// MEME | NEWS | ARTICLE | FILM | ANIME | MUSIC (рядок, щоб нові види не вимагали міграції)
  kind      String
  rarity    LootRarity
  title     String
  body      String     @default("")
  url       String     @default("")
  imageUrl  String     @default("")
  minutes   Int
  /// gemini | xkcd | hn
  source    String
  /// щоб той самий комікс чи стаття не потрапили в пул двічі
  dedupeKey String     @unique
  /// довге (фільм): випадає тільки після боса дня
  afterBoss Boolean    @default(false)
  expiresAt DateTime
  pulledAt  DateTime?
  pulls     RestPull[]
  createdAt DateTime   @default(now())

  @@index([rarity, pulledAt, expiresAt])
}

/// Один пул зі скрині. Вміст картки скопійовано сюди, бо статичні картки не в БД, а картки пулу з часом видаляються.
model RestPull {
  id         Int        @id @default(autoincrement())
  day        DateTime   @db.Date
  rarity     LootRarity
  kind       String
  title      String
  body       String     @default("")
  url        String     @default("")
  imageUrl   String     @default("")
  minutes    Int
  source     String
  /// чому рідкість не нижча за певну: "pity" (кожен 10-й пул) або "boss"
  guarantee  String     @default("")
  restCardId Int?
  restCard   RestCard?  @relation(fields: [restCardId], references: [id], onDelete: SetNull)
  openedAt   DateTime   @default(now())
  /// натиснув "Назад на карту"
  finishedAt DateTime?

  @@index([day])
}
