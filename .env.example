DATABASE_URL="postgresql://app:app@localhost:5433/learning"
# https://aistudio.google.com/apikey  (optional: without it the app works, just without AI grading and mock interviews)
GEMINI_API_KEY=""
# Model name from AI Studio (Google rotates the free models). Comma-separated: first is primary, the rest are fallbacks.
# On 429, 503, a cut-off reply, a 30-45 s hang, 404 or a request error the app moves to the next one; only the last is retried on 503 or a cut-off. Check: Sources -> Gemini.
GEMINI_MODEL="gemini-3.8-flash"
# Only for private repos in /sources: fine-grained token with Contents: read-only
GITHUB_TOKEN=""
# Levels (/levels): path to a local clone of live-code (vladio71/live-code), with npm install run inside it once.
# Code pasted on a level page runs the tests on this machine, which is why the app listens on 127.0.0.1 only.
LEVELS_DIR=""
# Telegram bot (npm run bot): token from @BotFather. The bot tells you the chat id: run it without TELEGRAM_CHAT_ID and send /start.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# When to send the first card of the day, in this machine's local time
TELEGRAM_SEND_AT="09:00"
# Time zone the app uses to compute "today". Empty locally = machine time. On Vercel, empty = Europe/Kyiv.
APP_TZ=""
# Token for the scripts on your machine (desk.py, morning.ps1, blocker): /api/state, /api/handoff, /api/plan/generate.
# Same string as in desk.json. Without it these endpoints answer 503. Generate: openssl rand -hex 24
AUTOMATION_TOKEN=""
